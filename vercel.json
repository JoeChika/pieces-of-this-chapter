{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/images/paragon-pink.svg", "destination": "/images/paragon-pink.jpg" },
    { "source": "/images/portrait-current.svg", "destination": "/images/portrait-current.jpg" }
  ]
}
